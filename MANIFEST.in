# 源码发行包（sdist）内容清单（2026-10-29）
# wheel 只含 Python 包（CLI/库）；完整应用（Web UI / 规则 / 术语表 / 文档）随 sdist 与本仓库交付。
include LICENSE
include README.md
include CHANGELOG.md
include CONTRIBUTING.md
include AGENTS.md
include rules.md
include app.py
include docker-compose.yml
include pyproject.toml
include requirements-core.txt
include requirements-pdf.txt
include requirements-full.txt
include .pre-commit-config.yaml
recursive-include glossary *.yaml
recursive-include vocab *.txt
recursive-include docs *.md
recursive-include skills *.md
recursive-include scripts *.py *.sh *.bat
recursive-include tests *.py *.pptx *.docx *.pdf
recursive-include .github *.yml *.md
recursive-include .streamlit *.toml
